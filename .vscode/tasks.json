{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Open noVNC",
      "type": "shell",
      "command": "echo ${input:openNoVnc}",
      "presentation": { "reveal": "never" },
      "runOptions": { "runOn": "folderOpen" }
    }
  ],
  "inputs": [
    {
      "id": "openNoVnc",
      "type": "command",
      "command": "simpleBrowser.show",
      "args": "http://localhost:6080/vnc.html?autoconnect=true&resize=scale"
    }
  ]
}